  m_SharedData: {fileID: 11400000, guid: eced69ca459a85843bc2821799f89062, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 33076883456
    m_Localized: "\u306A\u3057"
    m_Metadata:
      m_Items: []
  - m_Id: 1001
    m_Localized: "\u30C6\u30A4\u30EF\u30C3\u30C8\u5927\u9678\u306E\u5171\u901A\u901A\u8CA8\u3001\u4E16\u754C\u4E2D\u3067\u901A\u7528\u3059\u308B\u304A\u91D1\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1002
    m_Localized: "\u5922\u3092\u7E4B\u3050\u904B\u547D\u306E\u7A2E\u3002\u7E01\u77F3\u306E\u8F1D\u304D\u304C\u4E92\u3044\u306E\u904B\u547D\u3092\u7E54\u308A\u306A\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1003
    m_Localized: "\u65C5\u4EBA\u304C\u4E16\u754C\u3092\u63A2\u7D22\u3059\u308B\u6642\u306B\u6D88\u8CBB\u3059\u308B\u30A8\u30CD\u30EB\u30AE\u30FC\u3002\u6642\u9593\u3068\u3068\u3082\u306B\u81EA\u7136\u56DE\u5FA9\u3059\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1004
    m_Localized: "\u7A32\u59BB\u7279\u6709\u306E\u52FE\u7389\u3002\u96F7\u5143\u7D20\u306E\u30A8\u30CD\u30EB\u30AE\u30FC\u3092\u5BBF\u3057\u3066\u3044\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1005
    m_Localized: ' it shines with the light of unclaimed dreams and hopes.'
    m_Metadata:
      m_Items: []
  - m_Id: 2001
    m_Localized: "\u3042\u308A\u3075\u308C\u305F\u9244\u88FD\u306E\u9577\u5263\u3002\u5192\u967A\u8005\u306E\u9593\u3067\u306F\u3054\u304F\u4E00\u822C\u7684\u306A\u6B66\u5668\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2002
    m_Localized: "\u3042\u308A\u3075\u308C\u305F\u9244\u88FD\u306E\u76FE\u3002\u4E00\u822C\u7684\u306A\u653B\u6483\u3092\u9632\u3050\u3053\u3068\u304C\u3067\u304D\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2003
    m_Localized: "\u3042\u308A\u3075\u308C\u305F\u9769\u88FD\u306E\u93A7\u3002\u8EFD\u304F\u3066\u5B9F\u7528\u7684\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3001
    m_Localized: ' infused with the power of Electro.'
    m_Metadata:
      m_Items: []
  - m_Id: 3002
    m_Localized: "\u30AD\u30E3\u30C3\u30C4\u30C6\u30FC\u30EB\u306E\u4EBA\u6C17\u30D0\u30FC\u30C6\u30F3\u30C0\u30FC\u3001\u30C7\u30A3\u30AA\u30CA\u306E\u7279\u88FD\u30C9\u30EA\u30F3\u30AF\u3002\u672C\u4EBA\u306F\u7D76\u5BFE\u306B\u8A8D\u3081\u306A\u3044\u3060\u308D\u3046\u304C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 4001
    m_Localized: "\u3088\u304F\u898B\u304B\u3051\u308B\u679C\u7269\u3002\u30B7\u30E3\u30AD\u30B7\u30E3\u30AD\u3068\u3057\u305F\u6B6F\u3054\u305F\u3048\u3067\u3001\u4E00\u65E5\u4E00\u500B\u3067\u533B\u8005\u3044\u3089\u305A\u3068\u8A00\u308F\u308C\u3066\u3044\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 4002
    m_Localized: ' it makes a hearty and energizing meal.'
    m_Metadata:
      m_Items: []
  - m_Id: 4003
    m_Localized: ' rich in protein and a fundamental ingredient in countless dishes.'
    m_Metadata:
      m_Items: []
  - m_Id: 4004
    m_Localized: "\u9EC4\u91D1\u8272\u306B\u8F1D\u304F\u7A42\u7C92\u3002\u5927\u5730\u306B\u5E0C\u671B\u3068\u529B\u3092\u4E0E\u3048\u308B\u3001\u4E3B\u98DF\u3092\u4F5C\u308B\u305F\u3081\u306E\u91CD\u8981\u306A\u539F\u6599\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 4005
    m_Localized: ' easy to plant and harvest. It adds the perfect finishing touch
      to many dishes.'
    m_Metadata:
      m_Items: []
  - m_Id: 5001
    m_Localized: ' brewed from dandelion seeds with a refreshing aroma.'
    m_Metadata:
      m_Items: []
  - m_Id: 5002
    m_Localized: "\u30AD\u30E3\u30C3\u30C4\u30C6\u30FC\u30EB\u306E\u4EBA\u6C17\u30D0\u30FC\u30C6\u30F3\u30C0\u30FC\u3001\u30C7\u30A3\u30AA\u30CA\u306E\u7279\u88FD\u30C9\u30EA\u30F3\u30AF\u3002\u672C\u4EBA\u306F\u7D76\u5BFE\u306B\u8A8D\u3081\u306A\u3044\u3060\u308D\u3046\u304C\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 5003
    m_Localized: ' emitting a dangerous glow.'
    m_Metadata:
      m_Items: []
  - m_Id: 5004
    m_Localized: ' it seems to whisper with the breeze.'
    m_Metadata:
      m_Items: []
  - m_Id: 5005
    m_Localized: ' it never melts.'
    m_Metadata:
      m_Items: []
  - m_Id: 5006
    m_Localized: ' it symbolizes eternity and immutability.'
    m_Metadata:
      m_Items: []
  - m_Id: 5007
    m_Localized: ' as if it''s growing in your hand.'
    m_Metadata:
      m_Items: []
  - m_Id: 6001
    m_Localized: "\u5FAE\u304B\u306B\u8F1D\u304F\u53E4\u306E\u9375\u3002\u3069\u3053\u304B\u306B\u3042\u308B\u5FD8\u308C\u3089\u308C\u305F\u6249\u3092\u958B\u3051\u308B\u3053\u3068\u304C\u3067\u304D\u308B\u3088\u3046\u3060\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 6002
    m_Localized: ' chronicling lost civilizations and forbidden knowledge.'
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
