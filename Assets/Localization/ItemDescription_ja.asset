  - m_Id: 1005
    m_Localized: "\u4E16\u754C\u3092\u8D85\u3048\u305F\u539F\u521D\u306E\u6676\u77F3\u3002\u6697\u3044\u5B87\u5B99\u306E\u4E2D\u3067\u3001\u4E3B\u306A\u304D\u5922\u3068\u5E0C\u671B\u304C\u51DD\u7E2E\u3057\u3066\u3067\u304D\u305F\u8F1D\u304D\u3002"
