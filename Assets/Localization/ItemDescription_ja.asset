    m_Localized: "\u30AD\u30E3\u30C3\u30C4\u30C6\u30FC\u30EB\u306E\u4EBA\u6C17\u30D0\u30FC\u30C6\u30F3\u30C0\u30FC\u3001\u30C7\u30A3\u30AA\u30CA\u306E\u7279\u88FD\u30C9\u30EA\u30F3\u30AF\u3002\u672C\u4EBA\u306F\u7D76\u5BFE\u306B\u8A8D\u3081\u306A\u3044\u3060\u308D\u3046\u304C\u3002"
