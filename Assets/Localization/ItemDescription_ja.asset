      m_Items: []
  - m_Id: 4002
    m_Localized: "\u65B0\u9BAE\u306A\u7363\u8089\u306E\u584A\u3002\u9069\u5207\u306B\u8ABF\u7406\u3059\u308C\u3070\u3001\u5143\u6C17\u304C\u6E67\u304D\u51FA\u308B\u7F8E\u5473\u3057\u3044\u6599\u7406\u306B\u306A\u308B\u3002"
