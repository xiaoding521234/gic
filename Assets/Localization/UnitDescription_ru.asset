  m_TableData:
  - m_Id: 1001
    m_Localized: "\u041F\u0430\u0439\u043C\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2001
    m_Localized: "\u0426\u0438\u0431\u0430\u0439 \u2014 \u0411\u0435\u043B\u044B\u0439
      \u041A\u043E\u043D\u044C-\u0410\u0434\u0435\u043F\u0442 \u0438\u0437 \u043B\u0435\u0433\u0435\u043D\u0434
      \u041B\u0438 \u042E\u044D, \u0441\u0430\u043C\u0430\u044F \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u0430\u044F
      \u0444\u0438\u0433\u0443\u0440\u0430 \u0432 \u043C\u0438\u0444\u0430\u0445
      \u041B\u0438 \u042E\u044D."
    m_Metadata:
      m_Items: []
  - m_Id: 2002
    m_Localized: "\u041B\u0438\u043D\u043D\u0435\u044F \u2014 \u043D\u0435\u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0435
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E, \u0440\u043E\u0436\u0434\u0451\u043D\u043D\u043E\u0435
      \u0432 \u044D\u0442\u043E\u043C \u043C\u0438\u0440\u0435. \u0415\u0451 \u043F\u0443\u0442\u044C
      \u0432\u0437\u0440\u043E\u0441\u043B\u0435\u043D\u0438\u044F \u0433\u043E\u0440\u0430\u0437\u0434\u043E
      \u0433\u043E\u0440\u0448\u0435, \u0447\u0435\u043C \u0443 \u043E\u0431\u044B\u0447\u043D\u044B\u0445
      \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2003
    m_Localized: "\u0418\u043B\u043B\u044E\u0433\u0430 \u2014 \u0441\u0430\u043C\u044B\u0439
      \u043C\u043E\u043B\u043E\u0434\u043E\u0439 \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440
      \u043E\u0442\u0440\u044F\u0434\u0430 \u0425\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u0435\u0439
      \u0421\u0432\u0435\u0442\u0438\u043B\u044C\u043D\u0438\u043A\u043E\u0432, \u043F\u044B\u043B\u043A\u0438\u0439
      \u0438 \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u0439 \u0445\u0440\u0430\u043D\u0438\u0442\u0435\u043B\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 3001
    m_Localized: "\u042D\u043C\u0431\u0435\u0440 \u2014 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A
      \u0420\u044B\u0446\u0430\u0440\u0435\u0439 \u041E\u0440\u0434\u043E \u0424\u0430\u0432\u043E\u043D\u0438\u0443\u0441
      \u0438 \xAB\u0427\u0435\u043C\u043F\u0438\u043E\u043D\u043A\u0430 \u043F\u043E
      \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044E\xBB
      \u041C\u043E\u043D\u0434\u0448\u0442\u0430\u0434\u0442\u0430. \u041F\u043E\u043B\u043D\u0430\u044F
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u043E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0431\u0443\u0434\u0435\u0442 \u0441\u0430\u043C\u044B\u043C \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u043C
      \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 3002
    m_Localized: "\u041A\u044D\u0439\u0430 \u2014 \u043A\u0430\u043F\u0438\u0442\u0430\u043D
      \u043A\u0430\u0432\u0430\u043B\u0435\u0440\u0438\u0438 \u041E\u0440\u0434\u043E
      \u0424\u0430\u0432\u043E\u043D\u0438\u0443\u0441, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
      \u043A\u0430\u043A \xAB\u041B\u0435\u0434\u044F\u043D\u043E\u0439 \u043C\u0435\u0447\u043D\u0438\u043A\xBB.
      \u041D\u0430 \u043F\u0435\u0440\u0432\u044B\u0439 \u0432\u0437\u0433\u043B\u044F\u0434
      \u043E\u043D \u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0431\u0435\u0437\u0437\u0430\u0431\u043E\u0442\u043D\u044B\u043C,
      \u043D\u043E \u0432 \u0434\u0443\u0448\u0435 \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442
      \u0442\u0430\u0439\u043D\u044B, \u043D\u0435\u0432\u0435\u0434\u043E\u043C\u044B\u0435
      \u0434\u0440\u0443\u0433\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 3003
    m_Localized: "\u0411\u0430\u0440\u0431\u0430\u0440\u0430 \u2014 \u0434\u0438\u0430\u043A\u043E\u043D\u0438\u0441\u0441\u0430
      \u0426\u0435\u0440\u043A\u0432\u0438 \u0424\u0430\u0432\u043E\u043D\u0438\u0443\u0441
      \u0438 \u0441\u0438\u044F\u044E\u0449\u0430\u044F \u0438\u0434\u043E\u043B
      \u041C\u043E\u043D\u0434\u0448\u0442\u0430\u0434\u0442\u0430. \u0415\u0451
      \u043F\u0435\u043D\u0438\u0435 \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
      \u0441\u0438\u043B\u043E\u0439 \u0438\u0441\u0446\u0435\u043B\u044F\u0442\u044C
      \u0441\u0435\u0440\u0434\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3004
    m_Localized: "\u041B\u0438\u0437\u0430 \u2014 \u0431\u0438\u0431\u043B\u0438\u043E\u0442\u0435\u043A\u0430\u0440\u044C
      \u041E\u0440\u0434\u043E \u0424\u0430\u0432\u043E\u043D\u0438\u0443\u0441,
      \u0420\u043E\u0437\u0430-\u0432\u0435\u0434\u044C\u043C\u0430. \u0417\u0430
      \u0435\u0451 \u043B\u0435\u043D\u0438\u0432\u043E\u0439 \u0432\u043D\u0435\u0448\u043D\u043E\u0441\u0442\u044C\u044E
      \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043D\u0435\u043F\u043E\u0441\u0442\u0438\u0436\u0438\u043C\u043E\u0435
      \u043C\u0430\u0433\u0438\u0447\u0435\u0441\u043A\u043E\u0435 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 3005
    m_Localized: "\u0414\u0438\u043E\u043D\u0430 \u2014 \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u044B\u0439
      \u0431\u0430\u0440\u043C\u0435\u043D \u0432 \u0442\u0430\u0432\u0435\u0440\u043D\u0435
      \xAB\u041A\u043E\u0448\u0430\u0447\u0438\u0439 \u0445\u0432\u043E\u0441\u0442\xBB,
      \u0434\u0435\u0432\u0443\u0448\u043A\u0430, \u043F\u043E\u043A\u043B\u044F\u0432\u0448\u0430\u044F\u0441\u044F
      \u0443\u043D\u0438\u0447\u0442\u043E\u0436\u0438\u0442\u044C \u0432\u0438\u043D\u043D\u0443\u044E
      \u0438\u043D\u0434\u0443\u0441\u0442\u0440\u0438\u044E \u041C\u043E\u043D\u0434\u0448\u0442\u0430\u0434\u0442\u0430.
      \u041D\u043E \u0435\u0451 \u043A\u043E\u043A\u0442\u0435\u0439\u043B\u0438
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043E\u043A\u0430\u0437\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u0432\u043A\u0443\u0441\u043D\u044B\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 3006
    m_Localized: "\u0414\u0438\u043B\u044E\u043A \u2014 \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446
      \u0412\u0438\u043D\u043E\u043A\u0443\u0440\u043D\u0438 \xAB\u0420\u0430\u0441\u0441\u0432\u0435\u0442\xBB
      \u0438 \u0433\u0435\u0440\u043E\u0439 \u043D\u043E\u0447\u043D\u043E\u0433\u043E
      \u041C\u043E\u043D\u0434\u0448\u0442\u0430\u0434\u0442\u0430. \u0421 \xAB\u0412\u043E\u043B\u0447\u044C\u0435\u0439
      \u043C\u043E\u0433\u0438\u043B\u043E\u0439\xBB \u0432 \u0440\u0443\u043A\u0430\u0445
      \u043E\u043D \u0437\u0430\u0449\u0438\u0449\u0430\u0435\u0442 \u0433\u043E\u0440\u043E\u0434
      \u0438\u0437 \u0442\u044C\u043C\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 3007
    m_Localized: "\u0412\u0430\u0440\u043A\u0430 \u2014 \u0412\u0435\u043B\u0438\u043A\u0438\u0439
      \u043C\u0430\u0433\u0438\u0441\u0442\u0440 \u041E\u0440\u0434\u043E \u0424\u0430\u0432\u043E\u043D\u0438\u0443\u0441,
      \u0420\u044B\u0446\u0430\u0440\u044C \u0411\u043E\u0440\u0435\u0439. \u0412
      \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0435\u0435 \u0432\u0440\u0435\u043C\u044F
      \u043E\u043D \u0432\u043E\u0437\u0433\u043B\u0430\u0432\u043B\u044F\u0435\u0442
      \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044E \u0432 \u043F\u043E\u0445\u043E\u0434\u0435
      \u0438 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0436\u0438\u0432\u043E\u0439
      \u043B\u0435\u0433\u0435\u043D\u0434\u043E\u0439 \u041C\u043E\u043D\u0434\u0448\u0442\u0430\u0434\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 3008
    m_Localized: "\u0412\u0435\u043D\u0442\u0438 \u2014 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0439,
      \u043A\u0430\u043A \u0432\u0435\u0442\u0435\u0440, \u0431\u0430\u0440\u0434,
      \u0436\u0438\u0432\u0443\u0449\u0438\u0439 \u0432 \u0413\u043E\u0440\u043E\u0434\u0435
      \u0412\u0435\u0442\u0440\u043E\u0432. \u0415\u0433\u043E \u0438\u0441\u0442\u0438\u043D\u043D\u0430\u044F
      \u0441\u0443\u0449\u043D\u043E\u0441\u0442\u044C \u2014 \u0411\u0430\u0440\u0431\u0430\u0442\u043E\u0441,
      \u0410\u043D\u0435\u043C\u043E \u0410\u0440\u0445\u043E\u043D\u0442 \u041C\u043E\u043D\u0434\u0448\u0442\u0430\u0434\u0442\u0430,
      \u0442\u044B\u0441\u044F\u0447\u0435\u043B\u0435\u0442\u0438\u044F\u043C\u0438
      \u0432\u043E\u0441\u043F\u0435\u0432\u0430\u0432\u0448\u0438\u0439 \u0441\u0432\u043E\u0431\u043E\u0434\u0443
      \u044D\u0442\u043E\u0439 \u0437\u0435\u043C\u043B\u0438 \u0432 \u0441\u0442\u0438\u0445\u0430\u0445
      \u0438 \u043F\u0435\u0441\u043D\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 3009
    m_Localized: "\u0411\u0430\u0440\u0431\u0430\u0442\u043E\u0441 \u2014 \u043E\u0434\u0438\u043D
      \u0438\u0437 \u0421\u0435\u043C\u0435\u0440\u044B\u0445 \u0410\u0440\u0445\u043E\u043D\u0442\u043E\u0432
      \u041C\u043E\u043D\u0434\u0448\u0442\u0430\u0434\u0442\u0430, \u0411\u043E\u0433
      \u0421\u0432\u043E\u0431\u043E\u0434\u044B. \u041E\u043D \u0445\u043E\u0434\u0438\u0442
      \u0441\u0440\u0435\u0434\u0438 \u0441\u043C\u0435\u0440\u0442\u043D\u044B\u0445
      \u043A\u0430\u043A \u0412\u0435\u043D\u0442\u0438, \u043F\u0440\u0438\u0441\u043B\u0443\u0448\u0438\u0432\u0430\u044F\u0441\u044C
      \u043A \u0436\u0435\u043B\u0430\u043D\u0438\u044F\u043C \u043B\u044E\u0434\u0435\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 3010
    m_Localized: "\u0411\u0435\u043D\u043D\u0435\u0442 \u2014 \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u044C \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439
      \u0438\u0437 \u0413\u0438\u043B\u044C\u0434\u0438\u0438 \u0418\u0441\u043A\u0430\u0442\u0435\u043B\u0435\u0439
      \u041F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
      \u043A\u0430\u043A \xAB\u0418\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u0435
      \u0421\u0443\u0434\u044C\u0431\u044B\xBB. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u0443\u0436\u0430\u0441\u043D\u0443\u044E \u0443\u0434\u0430\u0447\u0443,
      \u043E\u043D \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043E\u0442\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043E\u0442 \u0441\u0432\u043E\u0435\u0439 \u043C\u0435\u0447\u0442\u044B
      \u043E \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F\u0445."
    m_Metadata:
      m_Items: []
  - m_Id: 4001
    m_Localized: "\u0421\u0438\u043D \u0426\u044E \u2014 \u0443\u0447\u0435\u043D\u0438\u043A
      \u043A\u043B\u0430\u043D\u0430 \u0413\u0443\u0445\u0443\u0430, \u0438\u0441\u043A\u0443\u0441\u043D\u044B\u0439
      \u0432 \u0444\u0435\u0445\u0442\u043E\u0432\u0430\u043D\u0438\u0438 \u0438
      \u043A\u0430\u043B\u043B\u0438\u0433\u0440\u0430\u0444\u0438\u0438. \u0412\u043D\u0435\u0448\u043D\u0435
      \u043E\u043D \u044D\u043B\u0435\u0433\u0430\u043D\u0442\u043D\u044B\u0439 \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0433\u043E\u0441\u043F\u043E\u0434\u0438\u043D, \u043D\u043E \u0432 \u0434\u0443\u0448\u0435
      \u2014 \u0441\u0438\u043B\u044C\u043D\u044B\u0439 \u0432\u043E\u0438\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 4002
    m_Localized: "\u0411\u044D\u0439 \u0414\u043E\u0443 \u2014 \u043A\u0430\u043F\u0438\u0442\u0430\u043D
      \u0444\u043B\u043E\u0442\u0430 \xAB\u042E\u0436\u043D\u044B\u0439 \u041A\u0440\u0435\u0441\u0442\xBB,
      \u043D\u0435\u043A\u043E\u0440\u043E\u043D\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0432\u043B\u0430\u0434\u044B\u043A\u0430 \u0434\u0440\u0430\u043A\u043E\u043D\u043E\u0432.
      \u041E\u0431\u043B\u0430\u0434\u0430\u044F \u0441\u043C\u0435\u043B\u044B\u043C
      \u0438 \u043F\u0440\u044F\u043C\u044B\u043C \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043E\u043C,
      \u043E\u043D\u0430 \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F
      \u043E\u0433\u0440\u043E\u043C\u043D\u044B\u043C \u0443\u0432\u0430\u0436\u0435\u043D\u0438\u0435\u043C
      \u0432 \u0433\u0430\u0432\u0430\u043D\u0438 \u041B\u0438 \u042E\u044D."
    m_Metadata:
      m_Items: []
  - m_Id: 4003
    m_Localized: "\u0421\u044F\u043D \u041B\u0438\u043D \u2014 \u043C\u043E\u043B\u043E\u0434\u043E\u0439
      \u0448\u0435\u0444-\u043F\u043E\u0432\u0430\u0440 \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D\u0430
      \xAB\u0412\u0430\u043D\u044C\u043C\u0438\u043D\u044C\xBB, \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0449\u0438\u0439
      \u043D\u0435\u043E\u0431\u044B\u0447\u0430\u0439\u043D\u043E\u0439 \u0441\u0442\u0440\u0430\u0441\u0442\u044C\u044E
      \u043A \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442\u0430\u043C.
      \u0415\u0451 \u0431\u043B\u044E\u0434\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442 \u043B\u044E\u0434\u044F\u043C
      \u0432\u043E\u0441\u0445\u0438\u0442\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
      \u0441\u044E\u0440\u043F\u0440\u0438\u0437\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 4004
    m_Localized: "\u041D\u0438\u043D \u0413\u0443\u0430\u043D \u2014 \u0445\u043E\u0437\u044F\u0439\u043A\u0430
      \u041D\u0435\u0444\u0440\u0438\u0442\u043E\u0432\u043E\u0433\u043E \u0427\u0435\u0440\u0442\u043E\u0433\u0430,
      \u0434\u0435\u043B\u043E\u0432\u043E\u0439 \u0433\u0435\u043D\u0438\u0439 \u041B\u0438
      \u042E\u044D. \u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u0438
      \u0438 \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u0430 \u043E\u043D\u0430
      \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u0430\u0440\u0442\u0435\u0440\u0438\u0435\u0439 \u041B\u0438 \u042E\u044D."
    m_Metadata:
      m_Items: []
  - m_Id: 4005
    m_Localized: "\u0425\u0443 \u0422\u0430\u043E \u2014 77-\u0439 \u0434\u0438\u0440\u0435\u043A\u0442\u043E\u0440
      \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u043D\u043E\u0433\u043E \u0431\u044E\u0440\u043E
      \xAB\u0412\u0430\u043D\u0448\u044D\u043D\xBB. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u043C\u043E\u043B\u043E\u0434\u043E\u0441\u0442\u044C, \u043E\u043D\u0430
      \u043E\u0442\u043B\u0438\u0447\u043D\u043E \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442
      \u0434\u0435\u043B\u0430\u043C\u0438 \u0431\u044E\u0440\u043E \u0438 \u0438\u043C\u0435\u0435\u0442
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0435 \u043F\u043E\u043D\u0438\u043C\u0430\u043D\u0438\u0435
      \u0436\u0438\u0437\u043D\u0438 \u0438 \u0441\u043C\u0435\u0440\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 4006
    m_Localized: "\u0413\u0430\u043D\u044C \u042E\u0439 \u2014 \u0441\u0435\u043A\u0440\u0435\u0442\u0430\u0440\u044C
      \u043F\u0430\u0432\u0438\u043B\u044C\u043E\u043D\u0430 \u042E\u044D\u0445\u0430\u0439,
      \u0432 \u0447\u044C\u0438\u0445 \u0436\u0438\u043B\u0430\u0445 \u0442\u0435\u0447\u0451\u0442
      \u043A\u0440\u043E\u0432\u044C \u0446\u0438\u043B\u0438\u043D\u0435\u0439.
      \u041E\u043D\u0430 \u0442\u0440\u0443\u0434\u043E\u043B\u044E\u0431\u0438\u0432\u0430
      \u043F\u043E\u0447\u0442\u0438 \u0434\u043E \u0444\u0430\u043D\u0430\u0442\u0438\u0437\u043C\u0430
      \u0438 \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0441\u044F \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u043C
      \u0434\u043E\u0432\u0435\u0440\u0438\u0435\u043C \u041D\u0438\u043D \u0413\u0443\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 5001
    m_Localized: "\u041C\u0438\u0437\u0443\u043A\u0438 \u2014 \u0437\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u0439
      \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436, \u0438\u0441\u043A\u0443\u0441\u043D\u044B\u0439
      \u0432 \u043C\u0430\u043D\u0438\u043F\u0443\u043B\u044F\u0446\u0438\u0438 \u0441\u043D\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 5002
    m_Localized: "\u0413\u043E\u0440\u043E \u2014 \u0433\u0435\u043D\u0435\u0440\u0430\u043B
      \u0430\u0440\u043C\u0438\u0438 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044F,
      \u0432\u0435\u0440\u043D\u044B\u0439 \u0432\u043E\u0438\u043D. \u041D\u0430
      \u043F\u043E\u043B\u0435 \u0431\u043E\u044F \u043E\u043D \u0432\u0441\u0435\u0433\u0434\u0430
      \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u0431\u043E\u0435\u0432\u043E\u0439
      \u0434\u0443\u0445 \u0438 \u0432\u0435\u0434\u0451\u0442 \u0441\u0432\u043E\u0438\u0445
      \u0441\u043E\u043B\u0434\u0430\u0442 \u0432 \u043E\u0442\u0432\u0430\u0436\u043D\u0443\u044E
      \u0431\u0438\u0442\u0432\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 5003
    m_Localized: "\u041A\u0438\u0440\u0430\u0440\u0430 \u2014 \u0434\u0435\u0432\u0443\u0448\u043A\u0430-\u043A\u0443\u0440\u044C\u0435\u0440
      \u0438\u0437 \u0418\u043D\u0430\u0434\u0437\u0443\u043C\u044B, \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0449\u0430\u044F
      \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C\u044E \u043A
      \u0442\u0440\u0430\u043D\u0441\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u0438.
      \u041E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 \u0434\u043E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442
      \u043F\u043E\u0441\u044B\u043B\u043A\u0438 \u0432\u043E\u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6001
    m_Localized: "\u0410\u043B\u044C-\u0425\u0430\u0439\u0442\u0430\u043C \u2014
      \u043F\u0438\u0441\u0430\u0440\u044C \u0410\u043A\u0430\u0434\u0435\u043C\u0438\u0438
      \u0421\u0443\u043C\u0435\u0440\u0443, \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u044B\u0439
      \u0438 \u0440\u0430\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
      \u0443\u0447\u0451\u043D\u044B\u0439. \u041E\u043D \u0441\u0442\u0440\u0435\u043C\u0438\u0442\u0441\u044F
      \u043A \u0438\u0441\u0442\u0438\u043D\u0435 \u0438 \u0437\u043D\u0430\u043D\u0438\u044F\u043C,
      \u0430 \u043D\u0435 \u043A \u0432\u043B\u0430\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6002
    m_Localized: "\u041A\u043E\u043B\u043B\u0435\u0438 \u2014 \u0441\u0442\u0430\u0436\u0451\u0440-\u0440\u0435\u0439\u043D\u0434\u0436\u0435\u0440
      \u0432 \u0421\u0443\u043C\u0435\u0440\u0443, \u0440\u0430\u043D\u0435\u0435
      \u0441\u0442\u0430\u0432\u0448\u0430\u044F \u0436\u0435\u0440\u0442\u0432\u043E\u0439
      \u044D\u043A\u0441\u043F\u0435\u0440\u0438\u043C\u0435\u043D\u0442\u043E\u0432
      \u0424\u0430\u0442\u0443\u0438. \u0421 \u043F\u043E\u043C\u043E\u0449\u044C\u044E
      \u0422\u0438\u0433\u043D\u0430\u0440\u0438 \u043E\u043D\u0430 \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E
      \u0432\u044B\u0445\u043E\u0434\u0438\u0442 \u0438\u0437 \u0442\u0435\u043D\u0438
      \u043F\u0440\u043E\u0448\u043B\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6003
    m_Localized: "\u041D\u0438\u043B\u0443 \u2014 \u0442\u0430\u043D\u0446\u043E\u0432\u0449\u0438\u0446\u0430
      \u0442\u0435\u0430\u0442\u0440\u0430 \u0417\u0443\u0431\u0430\u0439\u0440,
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F \u0441\u0432\u043E\u0438\u043C\u0438
      \u0433\u0440\u0430\u0446\u0438\u043E\u0437\u043D\u044B\u043C\u0438 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F\u043C\u0438.
      \u0415\u0451 \u0432\u044B\u0441\u0442\u0443\u043F\u043B\u0435\u043D\u0438\u044F
      \u0432\u0441\u0435\u0433\u0434\u0430 \u043F\u0440\u0438\u043D\u043E\u0441\u044F\u0442
      \u0434\u0443\u0448\u0435\u0432\u043D\u044B\u0439 \u043F\u043E\u043A\u043E\u0439
      \u0437\u0440\u0438\u0442\u0435\u043B\u044F\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 7001
    m_Localized: "\u0421\u0438\u0433\u0435\u0432\u0438\u043D\u043D \u2014 \u0441\u0442\u0430\u0440\u0448\u0430\u044F
      \u043C\u0435\u0434\u0441\u0435\u0441\u0442\u0440\u0430 \u041C\u0435\u0440\u043E\u043F\u0438\u0434\u0430,
      \u0442\u0430\u043A\u0436\u0435 \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F
      \u043A\u0430\u043A \xAB\u0427\u0443\u0434\u0435\u0441\u043D\u0430\u044F \u0434\u0435\u0432\u0443\u0448\u043A\u0430-\u0434\u0440\u0430\u043A\u043E\u043D\xBB.
      \u0414\u043E\u0431\u0440\u0430\u044F \u0438 \u043D\u0435\u0436\u043D\u0430\u044F,
      \u043E\u043D\u0430 \u043C\u043E\u043B\u0447\u0430 \u0437\u0430\u0431\u043E\u0442\u0438\u0442\u0441\u044F
      \u043E \u043A\u0430\u0436\u0434\u043E\u043C \u043F\u0430\u0446\u0438\u0435\u043D\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 7002
    m_Localized: "\u0420\u0438\u043E\u0442\u0441\u043B\u0438 \u2014 \u0430\u0434\u043C\u0438\u043D\u0438\u0441\u0442\u0440\u0430\u0442\u043E\u0440
      \u041C\u0435\u0440\u043E\u043F\u0438\u0434\u0430, \u0442\u0430\u0439\u043D\u044B\u0439
      \u043F\u043E\u0441\u043B\u0430\u043D\u043D\u0438\u043A \u0443\u0435\u0434\u0438\u043D\u0451\u043D\u043D\u043E\u0433\u043E
      \u0433\u0440\u0435\u0445\u0430. \u0417\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u0439
      \u0438 \u043D\u0435\u043F\u043E\u0441\u0442\u0438\u0436\u0438\u043C\u044B\u0439,
      \u043E\u043D, \u043A\u0430\u0436\u0435\u0442\u0441\u044F, \u043E\u0431\u043B\u0430\u0434\u0430\u0435\u0442
      \u043D\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043D\u043E\u0439 \u0441\u0438\u043B\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 7003
    m_Localized: "\u0422\u0438\u043E\u0440\u0438 \u2014 \u043F\u043E\u0440\u0442\u043D\u043E\u0439
      \u0432 \u0424\u043E\u043D\u0442\u0435\u0439\u043D\u0435, \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u044B\u0439
      \u043A\u0430\u043A \xAB\u0442\u043A\u0430\u0447 \u0433\u0440\u043E\u043C\u0430\xBB.
      \u041F\u0440\u043E\u0441\u043B\u0430\u0432\u043B\u0435\u043D\u043D\u0430\u044F
      \u0441\u0432\u043E\u0438\u043C \u0438\u0441\u043A\u0443\u0441\u043D\u044B\u043C
      \u0448\u0432\u0435\u0439\u043D\u044B\u043C \u043C\u0430\u0441\u0442\u0435\u0440\u0441\u0442\u0432\u043E\u043C,
      \u043E\u043D\u0430 \u043B\u044E\u0431\u0438\u043C\u0430 \u043A\u043B\u0438\u0435\u043D\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 11001
    m_Localized: ProtocolCore
    m_Metadata:
      m_Items: []
  - m_Id: 11002
    m_Localized: "\u041F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A
      \u0438\u0437 \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u043C\u0438\u0440\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0443\u0435\u0442
      \u043F\u043E \u0441\u0435\u043C\u0438 \u043D\u0430\u0446\u0438\u044F\u043C
      \u0422\u0435\u0439\u0432\u0430\u0442\u0430 \u0432 \u043F\u043E\u0438\u0441\u043A\u0430\u0445
      \u0441\u0432\u043E\u0435\u0433\u043E \u043F\u043E\u0442\u0435\u0440\u044F\u043D\u043D\u043E\u0433\u043E
      \u0431\u043B\u0438\u0437\u043D\u0435\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 4007
    m_Localized: "\u0417\u0430\u0433\u0430\u0434\u043E\u0447\u043D\u044B\u0439 \u043A\u043E\u043D\u0441\u0443\u043B\u044C\u0442\u0430\u043D\u0442
      \u043F\u043E\u0445\u043E\u0440\u043E\u043D\u043D\u043E\u0433\u043E \u0431\u044E\u0440\u043E
      \xAB\u0412\u0430\u043D\u0448\u044D\u043D\xBB, \u044D\u0440\u0443\u0434\u0438\u0442
      \u0441 \u0433\u043B\u0443\u0431\u043E\u043A\u0438\u043C\u0438 \u043F\u043E\u0437\u043D\u0430\u043D\u0438\u044F\u043C\u0438
      \u0432\u043E \u0432\u0441\u0451\u043C. \u041D\u0430 \u0441\u0430\u043C\u043E\u043C
      \u0434\u0435\u043B\u0435 \u2014 \u0437\u0435\u043C\u043D\u043E\u0435 \u0432\u043E\u043F\u043B\u043E\u0449\u0435\u043D\u0438\u0435
      \u041C\u043E\u0440\u0430\u043A\u0441\u0430, \u0413\u0435\u043E \u0410\u0440\u0445\u043E\u043D\u0442\u0430,
      \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0445\u0440\u0430\u043D\u0438\u0442
      \u041B\u0438 \u042E\u044D \u0432\u043E \u0438\u043C\u044F \u043A\u043E\u043D\u0442\u0440\u0430\u043A\u0442\u043E\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 5004
    m_Localized: "\u0420\u0430\u0439\u0434\u044D\u043D \u0421\u0451\u0433\u0443\u043D
      \u0418\u043D\u0430\u0434\u0437\u0443\u043C\u044B, \u0447\u044C\u0451 \u0438\u0441\u0442\u0438\u043D\u043D\u043E\u0435
      \u0438\u043C\u044F \u2014 \u042D\u0438. \u041E\u043D\u0430 \u0434\u0430\u0440\u043E\u0432\u0430\u043B\u0430
      \u0441\u0432\u043E\u0435\u043C\u0443 \u043D\u0430\u0440\u043E\u0434\u0443 \u043D\u0435\u0438\u0437\u043C\u0435\u043D\u043D\u0443\u044E
      \xAB\u0412\u0435\u0447\u043D\u043E\u0441\u0442\u044C\xBB, \u043F\u0440\u0430\u0432\u044F
      \u0447\u0435\u0440\u0435\u0437 \u043A\u0443\u043A\u043B\u0443, \u043F\u043E\u043A\u0430
      \u0435\u0451 \u0438\u0441\u0442\u0438\u043D\u043D\u0430\u044F \u0441\u0443\u0442\u044C
      \u0441\u043A\u0440\u044B\u0432\u0430\u043B\u0430\u0441\u044C \u0432 \u041F\u043B\u0430\u043D\u0435
      \u042D\u0432\u0442\u0438\u043C\u0438\u0438, \u0441\u0442\u0440\u0435\u043C\u044F\u0441\u044C
      \u043A \u0432\u0435\u0447\u043D\u043E\u043C\u0443 \u043F\u043E\u043A\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 6004
    m_Localized: "\u0414\u0435\u043D\u0434\u0440\u043E \u0410\u0440\u0445\u043E\u043D\u0442
      \u0421\u0443\u043C\u0435\u0440\u0443, \u041C\u0430\u043B\u043E\u0435 \u0412\u043B\u0430\u0434\u044B\u0447\u0435\u0441\u0442\u0432\u043E
      \u041A\u0443\u0441\u0430\u043D\u0430\u043B\u0438. \u041F\u043E\u0434 \u0434\u0435\u0442\u0441\u043A\u043E\u0439
      \u0432\u043D\u0435\u0448\u043D\u043E\u0441\u0442\u044C\u044E \u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u0433\u043B\u0443\u0431\u043E\u043A\u0430\u044F \u043C\u0443\u0434\u0440\u043E\u0441\u0442\u044C.
      \u041E\u043D\u0430 \u0442\u043A\u0451\u0442 \u0431\u0443\u0434\u0443\u0449\u0435\u0435
      \u0421\u0443\u043C\u0435\u0440\u0443 \u0447\u0435\u0440\u0435\u0437 \u0441\u043D\u044B
      \u0438 \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435,
      \u043E\u0431\u0435\u0440\u0435\u0433\u0430\u044F \u043B\u0438\u0441\u0442\u044C\u044F
      \u0414\u0440\u0435\u0432\u0430 \u0417\u043D\u0430\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 7004
    m_Localized: "\u0421\u0443\u043F\u0435\u0440\u0437\u0432\u0435\u0437\u0434\u0430
      \u0424\u043E\u043D\u0442\u0435\u0439\u043D\u0430, \u043D\u0435\u043A\u043E\u0433\u0434\u0430
      \u0438\u0437\u0432\u0435\u0441\u0442\u043D\u0430\u044F \u043A\u0430\u043A \xAB\u041A\u043E\u0440\u043E\u043B\u0435\u0432\u0430
      \u0432\u0441\u0435\u0445 \u0432\u043E\u0434, \u0440\u043E\u0434\u043E\u0432,
      \u043D\u0430\u0440\u043E\u0434\u043E\u0432 \u0438 \u0437\u0430\u043A\u043E\u043D\u043E\u0432\xBB.
      \u041E\u043D\u0430 \u0431\u044B\u043B\u0430 \u0447\u0435\u043B\u043E\u0432\u0435\u0447\u0435\u0441\u043A\u043E\u0439
      \u043F\u043E\u043B\u043E\u0432\u0438\u043D\u043E\u0439 \u0413\u0438\u0434\u0440\u043E
      \u0410\u0440\u0445\u043E\u043D\u0442\u0430 \u0424\u043E\u043A\u0430\u043B\u043E\u0440\u0441,
      \u0432\u044B\u043D\u0435\u0441\u0448\u0430\u044F \u043F\u044F\u0442\u044C \u0432\u0435\u043A\u043E\u0432
      \u043E\u0434\u0438\u043D\u043E\u0447\u0435\u0441\u0442\u0432\u0430 \u043D\u0430
      \u0441\u0446\u0435\u043D\u0435. \u0422\u0435\u043F\u0435\u0440\u044C, \u043A\u0430\u043A
      \u0441\u043C\u0435\u0440\u0442\u043D\u0430\u044F, \u043E\u043D\u0430 \u043D\u0430\u043A\u043E\u043D\u0435\u0446-\u0442\u043E
      \u043D\u0430\u0447\u0438\u043D\u0430\u0435\u0442 \u0441\u0432\u043E\u044E \u0441\u043E\u0431\u0441\u0442\u0432\u0435\u043D\u043D\u0443\u044E
      \u0436\u0438\u0437\u043D\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 8001
    m_Localized: "\u041F\u0438\u0440\u043E \u0410\u0440\u0445\u043E\u043D\u0442 \u041D\u0430\u0442\u043B\u0430\u043D\u0430,
      \u0431\u043E\u0433\u0438\u043D\u044F \u0432\u043E\u0439\u043D\u044B. \u0415\u0451
      \u043F\u044B\u043B\u0430\u044E\u0449\u0430\u044F \u0432\u043E\u043B\u044F \u043E\u0441\u0432\u0435\u0449\u0430\u0435\u0442
      \u0432\u0435\u0441\u044C \u041D\u0430\u0442\u043B\u0430\u043D \u043A\u0430\u043A
      \u044F\u0440\u043A\u043E\u0435 \xAB\u0421\u043E\u043B\u043D\u0446\u0435\xBB.
      \u0420\u0430\u0434\u0438 \u0431\u0443\u0434\u0443\u0449\u0435\u0433\u043E \u0441\u0432\u043E\u0435\u0433\u043E
      \u043D\u0430\u0440\u043E\u0434\u0430 \u043E\u043D\u0430 \u0433\u043E\u0442\u043E\u0432\u0430
      \u0441\u0436\u0435\u0447\u044C \u0441\u0435\u0431\u044F, \u0441\u043B\u0430\u0433\u0430\u044F
      \u043F\u043E\u044D\u043C\u0443 \u0432\u043E\u0437\u0440\u043E\u0436\u0434\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2004
    m_Localized: "\u0422\u0440\u0435\u0442\u044C\u044F \u0438\u0437 \u041F\u0440\u0435\u0434\u0432\u0435\u0441\u0442\u043D\u0438\u043A\u043E\u0432
      \u0424\u0430\u0442\u0443\u0438, \u043A\u043E\u0434\u043E\u0432\u043E\u0435
      \u0438\u043C\u044F \xAB\u0414\u0430\u043C\u0441\u0435\u043B\u0435\u0442\u0442\u0430\xBB.
      \u041E\u0431\u043B\u0430\u0434\u0430\u0435\u0442 \u0441\u0438\u043B\u043E\u0439
      \u043B\u0443\u043D\u044B, \u043E\u0434\u043D\u0430\u0436\u0434\u044B \u043F\u0435\u043B\u0430
      \u043F\u0435\u0447\u0430\u043B\u044C\u043D\u0443\u044E \u043F\u0435\u0441\u043D\u044E
      \u0443 \u0433\u0440\u043E\u0431\u0430. \u0425\u0440\u0443\u043F\u043A\u0430\u044F
      \u043D\u0430 \u0432\u0438\u0434, \u043E\u043D\u0430 \u0442\u0430\u0438\u0442
      \u0432 \u0441\u0435\u0431\u0435 \u0441\u0438\u043B\u0443, \u0434\u0430\u043B\u0435\u043A\u043E
      \u043F\u0440\u0435\u0432\u043E\u0441\u0445\u043E\u0434\u044F\u0449\u0443\u044E
      \u043E\u0431\u044B\u0447\u043D\u0443\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10001
    m_Localized: "\u0425\u0438\u043B\u0438\u0447\u0443\u0440\u043B \u0413\u0440\u043E\u043C\u0438\u043B\u0430
      \u0441 \u043F\u044B\u043B\u0430\u044E\u0449\u0438\u043C \u0442\u043E\u043F\u043E\u0440\u043E\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 28423079558983680
    m_Localized: "\u0414\u0436\u0438\u043D\u043D \u2014 \u0438.\u043E. \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u041C\u0430\u0433\u0438\u0441\u0442\u0440\u0430 \u041E\u0440\u0434\u043E \u0424\u0430\u0432\u043E\u043D\u0438\u0443\u0441,
      \u0420\u044B\u0446\u0430\u0440\u044C \u041E\u0434\u0443\u0432\u0430\u043D\u0447\u0438\u043A\u0430.
      \u0418\u0437\u0432\u0435\u0441\u0442\u043D\u0430 \u0441\u0432\u043E\u0435\u0439
      \u0441\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u044C\u044E \u043A \u0441\u0435\u0431\u0435
      \u0438 \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 28423079579955200
    m_Localized: "\u041F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u043D\u044B\u0435
      \u043E\u0431\u0438\u0442\u0430\u0442\u0435\u043B\u0438 \u043F\u0443\u0441\u0442\u043E\u0448\u0435\u0439
      \u0422\u0435\u0439\u0432\u0430\u0442\u0430, \u0436\u0438\u0432\u0443\u0449\u0438\u0435
      \u043F\u043B\u0435\u043C\u0435\u043D\u0430\u043C\u0438. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0439
      \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442, \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0442
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 3011
    m_Localized: "\u0414\u0436\u0438\u043D\u043D \u2014 \u0438.\u043E. \u0412\u0435\u043B\u0438\u043A\u043E\u0433\u043E
      \u041C\u0430\u0433\u0438\u0441\u0442\u0440\u0430 \u041E\u0440\u0434\u043E \u0424\u0430\u0432\u043E\u043D\u0438\u0443\u0441,
      \u0420\u044B\u0446\u0430\u0440\u044C \u041E\u0434\u0443\u0432\u0430\u043D\u0447\u0438\u043A\u0430.
      \u0418\u0437\u0432\u0435\u0441\u0442\u043D\u0430 \u0441\u0432\u043E\u0435\u0439
      \u0441\u0442\u0440\u043E\u0433\u043E\u0441\u0442\u044C\u044E \u043A \u0441\u0435\u0431\u0435
      \u0438 \u0440\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 10002
    m_Localized: "\u041F\u0440\u0438\u043C\u0438\u0442\u0438\u0432\u043D\u044B\u0435
      \u043E\u0431\u0438\u0442\u0430\u0442\u0435\u043B\u0438 \u043F\u0443\u0441\u0442\u043E\u0448\u0435\u0439
      \u0422\u0435\u0439\u0432\u0430\u0442\u0430, \u0436\u0438\u0432\u0443\u0449\u0438\u0435
      \u043F\u043B\u0435\u043C\u0435\u043D\u0430\u043C\u0438. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
      \u043D\u0430 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043D\u044B\u0439
      \u0438\u043D\u0442\u0435\u043B\u043B\u0435\u043A\u0442, \u043E\u0431\u043B\u0430\u0434\u0430\u044E\u0442
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u043E\u0439 \u043A\u0443\u043B\u044C\u0442\u0443\u0440\u043E\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 3012
    m_Localized: "\u0413\u043E\u0440\u043D\u0438\u0447\u043D\u0430\u044F \u041E\u0440\u0434\u043E
      \u0424\u0430\u0432\u043E\u043D\u0438\u0443\u0441, \u043C\u0435\u0447\u0442\u0430\u044E\u0449\u0430\u044F
      \u0441\u0442\u0430\u0442\u044C \u043D\u0430\u0441\u0442\u043E\u044F\u0449\u0438\u043C
      \u0440\u044B\u0446\u0430\u0440\u0435\u043C. \u0422\u0440\u0443\u0434\u043E\u043B\u044E\u0431\u0438\u0432\u0430\u044F
      \u0438 \u0434\u043E\u0431\u0440\u0430\u044F, \u043E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0441\u0442\u0430\u0440\u0430\u0435\u0442\u0441\u044F \u0438\u0437\u043E \u0432\u0441\u0435\u0445
      \u0441\u0438\u043B \u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F
      \u043E \u0442\u0435\u0445, \u043A\u0442\u043E \u0440\u044F\u0434\u043E\u043C."
