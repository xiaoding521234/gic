  - m_Id: 11512500209799168
    m_Localized: "\u897F\u98A8\u9A0E\u58EB\u56E3\u306E\u5075\u5BDF\u9A0E\u58EB\u3001\u30E2\u30F3\u30C9\u306E\u300C\u98DB\u884C\u51A0\u8ECD\u300D\u3002\u6D3B\u529B\u306B\u6E80\u3061\u305F\u5F7C\u5973\u306F\u3001\u5E38\u306B\u983C\u308A\u306B\u306A\u308B\u4EF2\u9593\u3067\u3059\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 26802933513924608
    m_Localized: "\u6700\u59272\u5C64\u3002\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u306B\u4FDD\u6301\u8005\u306E\u534A\u5F841\u30DE\u30B9\u4EE5\u5185\u306E\u6575\u306B\u653B\u6483\u529B20%\u306E\u6C37\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\u3002\u4FDD\u6301\u8005\u306E\u5143\u7D20\u30A8\u30CD\u30EB\u30AE\u30FC\u304C50%\u3092\u8D85\u3048\u308B\u3068\u7815\u3051\u30011\u679A\u306B\u3064\u304D\u653B\u6483\u529B30%\u5206HP\u3092\u56DE\u5FA9\u3059\u308B\u3002\u4FDD\u6301\u8005\u304C\u5012\u308C\u3066\u3082\u52B9\u679C\u306F\u7D99\u7D9A\u3059\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 26802933564256256
    m_Localized: "\u6700\u59271\u5C64\u3002\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u306B\u4FDD\u6301\u8005\u306E\u534A\u5F841\u30DE\u30B9\u4EE5\u5185\u306E\u6575\u306B\u653B\u6483\u529B10%\u306E\u6C34\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u3001\u5473\u65B9\u306EHP\u309210\u56DE\u5FA9\u3057\u3001\u7406\u6027\u30921\u56DE\u5FA9\u3057\u3001\u6C34\u5143\u7D20\u3092\u4ED8\u7740\u3059\u308B\u3002\u4FDD\u6301\u8005\u304C\u5012\u308C\u308B\u3068\u6D88\u3048\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 26802933564256257
    m_Localized: "\u540C\u6642\u306B1\u3064\u307E\u3067\u5B58\u5728\u3057\u3001\u521D\u671F\u306F\u30EA\u30B5\u81EA\u8EAB\u3092\u6A19\u8A18\u3059\u308B\u3002\u4FDD\u6301\u8005\u304C\u6575\u304B\u3089\u30C0\u30E1\u30FC\u30B8\u3092\u53D7\u3051\u305F\u6642\u3001\u305D\u306E\u6575\u306E\u4F4D\u7F6E\u306B\u96F7\u3092\u843D\u3068\u3057\u3001\u534A\u5F841\u30DE\u30B9\u4EE5\u5185\u306E\u6575\u306B\u4FDD\u6301\u8005\u653B\u6483\u529B30%\u306E\u96F7\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\uFF08\u30BF\u30FC\u30F31\u56DE\u307E\u3067\uFF09\u3002\u30EA\u30B5\u306E\u5EF6\u594F\u6642\u306F\u9023\u643A\u5148\u3078\u79FB\u308A\u3001\u4FDD\u6301\u8005\u304C\u6D88\u6563\u3057\u305F\u5834\u5408\u306F\u30EA\u30B5\u3078\u623B\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 26802933564256258
    m_Localized: "\u30BF\u30FC\u30F3\u7D42\u4E86\u6642\u306B\u534A\u5F843\u30DE\u30B9\u4EE5\u5185\u306E\u6575\u30921\u30DE\u30B9\u5F15\u304D\u5BC4\u305B\u3001\u653B\u6483\u529B50%\u306E\u98A8\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u308B\uFF1B\u5473\u65B9\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u306B\u653B\u6483\u529B20%\u306E\u30B7\u30FC\u30EB\u30C9\u3068\u976D\u60275\u3092\u4ED8\u4E0E\u3002\u84B2\u516C\u82F1\u306E\u98A8\u306E\u5B58\u5728\u6642\u9593\u30921\u30BF\u30FC\u30F3\u5EF6\u9577\u30023\u30BF\u30FC\u30F3\u6301\u7D9A\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 26802933564256259
    m_Localized: "\u6700\u59273\u672C\u3002\u5473\u65B9\u30AD\u30E3\u30E9\u30AF\u30BF\u30FC\u304C\u6226\u6280\u30C0\u30E1\u30FC\u30B8\u3092\u4E0E\u3048\u305F\u6642\u3001\u96E8\u7C3E\u5263\u30921\u672C\u6D88\u8CBB\u3057\u3001\u5BFE\u8C61\u306B\u653B\u6483\u529B40%\u306E\u6C34\u30C0\u30E1\u30FC\u30B8\uFF08\u5354\u540C\u30C0\u30E1\u30FC\u30B8\uFF09\u3092\u4E0E\u3048\u308B\u3002\u4FDD\u6301\u8005\u304C\u5012\u308C\u308B\u3068\u6D88\u53BB\u3055\u308C\u308B\u3002"
