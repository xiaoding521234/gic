  - m_Id: 3011004
    m_Localized: "\xB7\u0421\u043E\u0437\u0434\u0430\u0442\u044C \u043F\u043E {WindFieldRange}
      \u043A\u043B\u0435\u0442\u043E\u043A \u041E\u0434\u0443\u0432\u0430\u043D\u0447\u0438\u043A\u043E\u0432\u043E\u0433\u043E
      \u0432\u0435\u0442\u0440\u0430 \u0432 \u043A\u0430\u0436\u0434\u043E\u043C
      \u0438\u0437 \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439
      \u043E\u0442 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430, \u0432\u0435\u0442\u0435\u0440
      \u0434\u0443\u0435\u0442 \u043E\u0442 \u043D\u0435\u0433\u043E"
