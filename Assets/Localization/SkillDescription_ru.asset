  - m_Id: 3001006
    m_Localized: "\xB7[C1] \u041E\u0431\u0437\u043E\u0440 +{C1Vision}. \u0415\u0441\u043B\u0438
      \u042D\u043C\u0431\u0435\u0440 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u044D\u043D\u0435\u0440\u0433\u0438\u044E \u043F\u0440\u0438 \u043F\u043E\u043B\u043D\u043E\u043C
      \u0437\u0430\u043F\u0430\u0441\u0435, \u0438\u0437\u043B\u0438\u0448\u0435\u043A
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C\u0443
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0443 \u0441 \u043D\u0435\u043F\u043E\u043B\u043D\u043E\u0439
      \u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439; \u0435\u0441\u043B\u0438
      \u0443 \u0432\u0441\u0435\u0445 \u043F\u043E\u043B\u043D\u0430\u044F \u2014
      \u044D\u0444\u0444\u0435\u043A\u0442\u0430 \u043D\u0435\u0442\n\xB7[C2] \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u0445\u043E\u0434\u0430 +{C2MoveSpeed}, \u043C\u0430\u043A\u0441. \u044D\u043D\u0435\u0440\u0433\u0438\u044F
      +{C2EnergyLimit}; \u0412\u0437\u0440\u044B\u0432 \u0440\u0430\u0441\u0441\u0435\u0438\u0432\u0430\u0435\u0442
      \u0442\u0443\u043C\u0430\u043D, \u0434\u0430\u0432\u0430\u044F {C2FogEnergyGain}
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0435
