      \u0432 \u043F\u0440\u0435\u0434\u0435\u043B\u0430\u0445 {CloseRange} \u043A\u043B\u0435\u0442\u043E\u043A:
      \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442 {Damage} \u0410\u043D\u0435\u043C\u043E
      \u0443\u0440\u043E\u043D\u0430 \u0438 \u043E\u0442\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u044E\u0442\u0441\u044F
      \u043D\u0430 {Knockback} \u043A\u043B\u0435\u0442\u043E\u043A\n\xB7\u041C\u0430\u043A\u0441.
      \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C {MaxRange} \u043A\u043B\u0435\u0442\u043E\u043A"
