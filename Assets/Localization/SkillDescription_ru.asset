  - m_Id: 3001002
    m_Localized: "\xB7\u0412\u044B\u043F\u0443\u0441\u0442\u0438\u0442\u044C {DamageCount}
      \u0441\u0442\u0440\u0435\u043B\u044B \u0432 \u043E\u0434\u043D\u043E\u043C
