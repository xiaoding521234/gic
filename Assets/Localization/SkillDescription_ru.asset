      m_Items: []
  - m_Id: 26206775267635200
    m_Localized: "\xB7\u0412\u043E\u0441\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u044C
      \u0441\u0435\u0431\u0435 {Heal} HP"
    m_Metadata:
      m_Items: []
  - m_Id: 26206775267635201
    m_Localized: "\xB7[C1] \u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
      \u043B\u0435\u0447\u0435\u043D\u0438\u044F +{C1HealEfficiency}, \u0412\u0430\u043C\u043F\u0438\u0440\u0438\u0437\u043C
      +{C1LifeSteal}\n\xB7[C2] <color=#FFD700><u><link=\"Buff:\u5BD2\u51B0\u4E4B\u68F1\">\u041B\u0435\u0434\u044F\u043D\u043E\u0439
      \u043E\u0441\u043A\u043E\u043B\u043E\u043A</link></u></color> \u043B\u0438\u043C\u0438\u0442
      \u0441\u0442\u0430\u043A\u043E\u0432 +{C2StackLimit}, \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F
      \u0441\u043D\u0438\u0436\u0430\u044E\u0442 \u0437\u0430\u0449\u0438\u0442\u0443
      \u0432\u0440\u0430\u0433\u0430 \u043D\u0430 {C2DefenseReduce}\n\xB7[C3] <color=#FFD700><u><link=\"Buff:\u5BD2\u51B0\u4E4B\u68F1\">\u041B\u0435\u0434\u044F\u043D\u043E\u0439
      \u043E\u0441\u043A\u043E\u043B\u043E\u043A</link></u></color> \u043B\u0438\u043C\u0438\u0442
      \u0441\u0442\u0430\u043A\u043E\u0432 +{C3StackLimit}, \u0440\u0430\u0434\u0438\u0443\u0441
      +{C3Radius}"
    m_Metadata:
      m_Items: []
  - m_Id: 26206775267635202
    m_Localized: "\xB7\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430:
