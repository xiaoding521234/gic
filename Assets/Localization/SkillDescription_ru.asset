    m_Metadata:
      m_Items: []
  - m_Id: 3001006
    m_Localized: "\xB7[C1] \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0445\u043E\u0434\u0430
      +{C1MoveSpeed}, \u041E\u0431\u0437\u043E\u0440 +{C1Vision}\n\xB7[C2] \u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      \u0445\u043E\u0434\u0430 +{C2MoveSpeed}. \u0412\u0437\u0440\u044B\u0432 \u0440\u0430\u0441\u0441\u0435\u0438\u0432\u0430\u0435\u0442
      \u0442\u0443\u043C\u0430\u043D, \u0434\u0430\u0451\u0442 {C2FogEnergyGain}
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0435
      {C2FogEnergyThreshold} \u043A\u043B\u0435\u0442\u043E\u043A\n\xB7[C3] \u041F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
      <color=#FFD700><u><link=\"Unit:Amber\">\u0411\u0430\u0440\u043E\u043D \u0417\u0430\u0439\u043A\u0430</link></u></color>"
    m_Metadata:
      m_Items: []
  - m_Id: 26206775032754176
    m_Localized: "\xB7\u0412\u044B\u0431\u0440\u043E\u0441\u0438\u0442\u044C \u043C\u043E\u0440\u043E\u0437
