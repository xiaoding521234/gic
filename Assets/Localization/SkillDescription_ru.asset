  - m_Id: 3011005
    m_Localized: "\xB7\u0415\u0441\u043B\u0438 \u0414\u0436\u0438\u043D\u043D \u043D\u0430
      \u041E\u0434\u0443\u0432\u0430\u043D\u0447\u0438\u043A\u043E\u0432\u043E\u043C
      \u0432\u0435\u0442\u0440\u0435, \u0440\u044B\u0432\u043E\u043A \u0432\u0434\u043E\u043B\u044C
      \u0435\u0433\u043E \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F\n\xB7\u041F\u043E\u0441\u043B\u0435
      \u0441\u0445\u043E\u0434\u0430 \u0441 \u0432\u0435\u0442\u0440\u0430 \u0440\u044B\u0432\u043E\u043A
      \u0435\u0449\u0451 \u0434\u043E {DashRange} \u043A\u043B\u0435\u0442\u043E\u043A\n\xB7\u041F\u0440\u043E\u0445\u043E\u0434\u044F
      \u0434\u0440\u0443\u0433\u0438\u0435 \u041E\u0434\u0443\u0432\u0430\u043D\u0447\u0438\u043A\u043E\u0432\u044B\u0435
      \u0432\u0435\u0442\u0440\u044B \u0432 \u0440\u044B\u0432\u043A\u0435: \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C
      +{MoveSpeedBonus} \u043D\u0430 {MoveSpeedDuration} \u0445\u043E\u0434\u0430;
      \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435 \u0440\u044B\u0432\u043A\u0430
      \u043C\u0435\u043D\u044F\u0435\u0442\u0441\u044F \u043D\u0430 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435
      \u044D\u0442\u043E\u0433\u043E \u0432\u0435\u0442\u0440\u0430, \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      \u043E\u0431\u043D\u043E\u0432\u043B\u044F\u0435\u0442\u0441\u044F (\u043A\u0430\u0436\u0434\u044B\u0439
      \u0432\u0435\u0442\u0435\u0440 \u0443\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043E\u0434\u0438\u043D \u0440\u0430\u0437)\n\xB7\u0415\u0441\u043B\u0438
      \u0440\u044B\u0432\u043E\u043A \u0437\u0430\u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u043D
      \u0432\u0440\u0430\u0433\u043E\u043C, \u043D\u0430\u043D\u0435\u0441\u0442\u0438
      \u0435\u043C\u0443 {Damage}+{MoveSpeedDamage} \u0443\u0440\u043E\u043D\u0430,
      \u0441\u0447\u0438\u0442\u0430\u0435\u0442\u0441\u044F \u0443\u0440\u043E\u043D\u043E\u043C
      \u043D\u0430\u0432\u044B\u043A\u0430\n\xB7\u0415\u0441\u043B\u0438 \u0414\u0436\u0438\u043D\u043D
      \u043D\u0435 \u043D\u0430 \u0432\u0435\u0442\u0440\u0435, \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442
      \u043A \u0434\u0430\u043B\u044C\u043D\u0435\u043C\u0443 \u041E\u0434\u0443\u0432\u0430\u043D\u0447\u0438\u043A\u043E\u0432\u043E\u043C\u0443
      \u0432\u0435\u0442\u0440\u0443 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435
      {TeleportRange} \u043A\u043B\u0435\u0442\u043E\u043A; \u0431\u0435\u0437 \u0432\u0435\u0442\u0440\u0430
      \u2014 \u043D\u0435 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 3011006
    m_Localized: "\xB7[C0] \u041A\u043E\u0433\u0434\u0430 \u0414\u0436\u0438\u043D\u043D
      \u0432\u0441\u0442\u0443\u043F\u0430\u0435\u0442 \u0432 \u0431\u043E\u0439,
      \u0432\u0441\u0435 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u044E\u0442
      \u0449\u0438\u0442 {C0Shield}\n\xB7[C1] \u041A\u043B\u0438\u043D\u043E\u043A
      \u0431\u0443\u0440\u044C \u043C\u043E\u0436\u0435\u0442 \u043F\u043E\u0440\u0430\u0436\u0430\u0442\u044C
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432 (\u0431\u0435\u0437
      \u0443\u0440\u043E\u043D\u0430), \u043C\u0430\u043A\u0441. \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C
      +{C1RangeBonus}\n\xB7[C2] \u041E\u0434\u0443\u0432\u0430\u043D\u0447\u0438\u043A\u043E\u0432\u044B\u0439
      \u0432\u0435\u0442\u0435\u0440 \u0434\u043B\u0438\u0442\u0441\u044F \u043D\u0430
      {C2DurationBonus} \u0445\u043E\u0434\u0430 \u0434\u043E\u043B\u044C\u0448\u0435
      \u0438 \u043F\u0440\u0438 \u043F\u0440\u0438\u0442\u044F\u0433\u0438\u0432\u0430\u043D\u0438\u0438
      \u0432\u0440\u0430\u0433\u0430 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0435\u043C\u0443
      {C2ThornDamage} \u0410\u043D\u0435\u043C\u043E \u0443\u0440\u043E\u043D\u0430\n\xB7[C3]
      \u0412\u0435\u0442\u0440\u044B \u043E\u0442 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
      \u0414\u0436\u0438\u043D\u043D \u0434\u0443\u044E\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
      \u043F\u0440\u043E\u0442\u0438\u0432\u043E\u043F\u043E\u043B\u043E\u0436\u043D\u0443\u044E
      \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 3012001
    m_Localized: "\xB7\u0412\u044B\u0431\u0440\u0430\u0442\u044C \u043E\u0434\u043D\u043E
      \u0438\u0437 \u0447\u0435\u0442\u044B\u0440\u0451\u0445 \u043D\u0430\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0439
