  - m_Id: 26802933513924608
    m_Localized: "\xB7\u4E0A\u9650{BaseStackLimit}\u5C64\n\xB7\u6BCF 2 \u79D2\u5C0D\u6301\u6709\u8005\u534A\u5F91{AuraRadius}\u5167\u6575\u4EBA\u9020\u6210{AuraDamagePercent}\u7684\u51B0\u50B7\n\xB7\u6301\u6709\u8005\u5143\u80FD\u8D85\u904E{ShatterEnergyThreshold}\u6642\u788E\u88C2\uFF0C\u6BCF\u679A\u6CBB\u7642\u6301\u6709\u8005{ShatterHealPercent}\u7684\u751F\u547D\u503C\n\xB7\u5DF2\u6EFF\u5C64\u6642\u518D\u6B21\u65BD\u653E\uFF0C\u6EA2\u51FA\u7684\u5C64\u6578\u7ACB\u5373\u788E\u88C2\uFF0C\u6BCF\u679A\u6CBB\u7642\u6301\u6709\u8005{ShatterHealPercent}\u7684\u751F\u547D\u503C\n\xB7\u6301\u6709\u8005\u5012\u4E0B\u5F8C\u4ECD\u7136\u751F\u6548\uFF0C\u5012\u4E0B\u6642\u788E\u88C2\u5247\u4E0D\u6703\u6CBB\u7642"
