  - m_Id: 1
    m_Localized: "{Durability}\u9EDE\u8010\u4E45\u3002\u7576\u6301\u6709\u8005\u53D7\u5230{BlockThreshold}\u53CA\u4EE5\u4E0A\u7684\u50B7\u5BB3\u6642\uFF0C\u5154\u5154\u4F2F\u7235\u62B5\u64CB\u8A72\u50B7\u5BB3\uFF0C\u4E26\u6E1B\u5C111\u9EDE\u8010\u4E45\uFF1B\u8010\u4E45\u6BCF\u6B21\u6E1B\u5C11\u6642\uFF0C\u5C0D\u534A\u5F91{ExplodeRadius}\u5167\u7684\u6575\u4EBA\u9020\u6210{ExplodePercent}%\u653B\u64CA\u529B\u706B\u50B7\u3002\u8010\u4E45\u8017\u76E1\u5F8C\u4E0D\u518D\u751F\u6548\uFF0C\u4F46\u4E0D\u6703\u92B7\u6BC0\uFF1B\u6301\u6709\u8005\u6BCF\u6B21\u63A1\u96C6\u6642\u6062\u5FA91\u9EDE\u8010\u4E45\u3002"
