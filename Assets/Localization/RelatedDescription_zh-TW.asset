  - m_Id: 26802933564256256
    m_Localized: "\xB7\u4E0A\u96501\u5C64\n\xB7\u6BCF 2 \u79D2\u5C0D\u6301\u6709\u8005\u534A\u5F91{AuraRadius}\u5167\u7684\u6575\u4EBA\u9020\u6210\u65BD\u52A0\u8005{AuraDamagePercent}\u7684\u6C34\u50B7\n\xB7\u6BCF
