  m_TableData:
  - m_Id: 1
    m_Localized: "3 \u043E\u0447\u043A\u0430 \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u0438.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 50 \u0438\u043B\u0438 \u0431\u043E\u043B\u0435\u0435
      \u0435\u0434\u0438\u043D\u0438\u0446 \u0443\u0440\u043E\u043D\u0430, \u0411\u0430\u0440\u043E\u043D
      \u0417\u0430\u0439\u043A\u0430 \u0431\u043B\u043E\u043A\u0438\u0440\u0443\u0435\u0442
      \u0443\u0440\u043E\u043D \u0438 \u0442\u0435\u0440\u044F\u0435\u0442 1 \u043E\u0447\u043A\u043E
      \u043F\u0440\u043E\u0447\u043D\u043E\u0441\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 11512500209799168
    m_Localized: "\u042D\u043C\u0431\u0435\u0440 \u2014 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A
      \u0420\u044B\u0446\u0430\u0440\u0435\u0439 \u041E\u0440\u0434\u043E \u0424\u0430\u0432\u043E\u043D\u0438\u0443\u0441
      \u0438 \xAB\u0427\u0435\u043C\u043F\u0438\u043E\u043D\u043A\u0430 \u043F\u043E
      \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u0438\u044E\xBB
      \u041C\u043E\u043D\u0434\u0448\u0442\u0430\u0434\u0442\u0430. \u041F\u043E\u043B\u043D\u0430\u044F
      \u044D\u043D\u0435\u0440\u0433\u0438\u0438, \u043E\u043D\u0430 \u0432\u0441\u0435\u0433\u0434\u0430
      \u0431\u0443\u0434\u0435\u0442 \u0441\u0430\u043C\u044B\u043C \u043D\u0430\u0434\u0451\u0436\u043D\u044B\u043C
      \u0442\u043E\u0432\u0430\u0440\u0438\u0449\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 26802933513924608
    m_Localized: "\u0414\u043E 2 \u0441\u0442\u0430\u043A\u043E\u0432. \u0412 \u043A\u043E\u043D\u0446\u0435
      \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0445\u043E\u0434\u0430 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u041A\u0440\u0438\u043E \u0443\u0440\u043E\u043D, \u0440\u0430\u0432\u043D\u044B\u0439
      20% \u0410\u0422\u041A, \u0432\u0440\u0430\u0433\u0430\u043C \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435
      1 \u043A\u043B\u0435\u0442\u043A\u0438 \u043E\u0442 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430.
      \u041A\u043E\u0433\u0434\u0430 \u044D\u043D\u0435\u0440\u0433\u0438\u044F \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430
      \u043F\u0440\u0435\u0432\u044B\u0448\u0430\u0435\u0442 50%, \u043E\u0441\u043A\u043E\u043B\u043A\u0438
      \u0440\u0430\u0437\u0431\u0438\u0432\u0430\u044E\u0442\u0441\u044F \u0438 \u043B\u0435\u0447\u0430\u0442
      \u0435\u0433\u043E \u043D\u0430 30% \u0410\u0422\u041A \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439.
      \u0414\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442, \u0434\u0430\u0436\u0435
      \u0435\u0441\u043B\u0438 \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u043F\u043E\u0432\u0435\u0440\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 26802933564256256
    m_Localized: "\u041D\u0435 \u0441\u0443\u043C\u043C\u0438\u0440\u0443\u0435\u0442\u0441\u044F.
      \u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0445\u043E\u0434\u0430 \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0413\u0438\u0434\u0440\u043E
      \u0443\u0440\u043E\u043D, \u0440\u0430\u0432\u043D\u044B\u0439 10% \u0410\u0422\u041A,
      \u0432\u0440\u0430\u0433\u0430\u043C \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435
      1 \u043A\u043B\u0435\u0442\u043A\u0438, \u043B\u0435\u0447\u0438\u0442 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u0432
      \u043D\u0430 10 HP, \u0432\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442
      1 \u0440\u0430\u0441\u0441\u0443\u0434\u043A\u0430 \u0438 \u043D\u0430\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442
      \u0413\u0438\u0434\u0440\u043E. \u0418\u0441\u0447\u0435\u0437\u0430\u0435\u0442
      \u043F\u0440\u0438 \u043F\u0430\u0434\u0435\u043D\u0438\u0438 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 26802933564256257
    m_Localized: "\u041E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E
      \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442 \u043B\u0438\u0448\u044C
      \u043E\u0434\u043D\u0430 \u043C\u0435\u0442\u043A\u0430; \u0438\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E
      \u043F\u043E\u043C\u0435\u0447\u0435\u043D\u0430 \u0441\u0430\u043C\u0430 \u041B\u0438\u0437\u0430.
      \u041A\u043E\u0433\u0434\u0430 \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446
      \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0443\u0440\u043E\u043D \u043E\u0442
      \u0432\u0440\u0430\u0433\u0430, \u0432 \u043F\u043E\u0437\u0438\u0446\u0438\u044E
      \u0432\u0440\u0430\u0433\u0430 \u0431\u044C\u0451\u0442 \u043C\u043E\u043B\u043D\u0438\u044F,
      \u043D\u0430\u043D\u043E\u0441\u044F \u042D\u043B\u0435\u043A\u0442\u0440\u043E
      \u0443\u0440\u043E\u043D, \u0440\u0430\u0432\u043D\u044B\u0439 30% \u0410\u0422\u041A
      \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430, \u0432\u0440\u0430\u0433\u0430\u043C
      \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 1 \u043A\u043B\u0435\u0442\u043A\u0438,
      \u043D\u0435 \u0447\u0430\u0449\u0435 1 \u0440\u0430\u0437\u0430 \u0437\u0430
      \u0445\u043E\u0434. \u041F\u0440\u0438 \u042D\u043D\u0441\u043E \u041B\u0438\u0437\u044B
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0443;
      \u043F\u0440\u0438 \u0438\u0441\u0447\u0435\u0437\u043D\u043E\u0432\u0435\u043D\u0438\u0438
      \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
      \u041B\u0438\u0437\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 26802933564256258
    m_Localized: "\u0412 \u043A\u043E\u043D\u0446\u0435 \u043A\u0430\u0436\u0434\u043E\u0433\u043E
      \u0445\u043E\u0434\u0430 \u043F\u0440\u0438\u0442\u044F\u0433\u0438\u0432\u0430\u0435\u0442
      \u0432\u0440\u0430\u0433\u043E\u0432 \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435
      3 \u043A\u043B\u0435\u0442\u043E\u043A \u043D\u0430 1 \u043A\u043B\u0435\u0442\u043A\u0443
      \u043A \u0441\u0435\u0431\u0435 \u0438 \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0410\u043D\u0435\u043C\u043E \u0443\u0440\u043E\u043D, \u0440\u0430\u0432\u043D\u044B\u0439
      50% \u0410\u0422\u041A; \u0434\u0430\u0451\u0442 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u0430\u043C
      \u0449\u0438\u0442 \u0432 20% \u0410\u0422\u041A \u0438 5 \u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438.
      \u041F\u0440\u043E\u0434\u043B\u0435\u0432\u0430\u0435\u0442 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u0438\u0435
      \u041E\u0434\u0443\u0432\u0430\u043D\u0447\u0438\u043A\u043E\u0432\u043E\u0433\u043E
      \u0432\u0435\u0442\u0440\u0430 \u043D\u0430 1 \u0445\u043E\u0434. \u0414\u043B\u0438\u0442\u0441\u044F
      3 \u0445\u043E\u0434\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 26802933564256259
    m_Localized: "\u0414\u043E 3 \u043C\u0435\u0447\u0435\u0439. \u041A\u043E\u0433\u0434\u0430
      \u0441\u043E\u044E\u0437\u043D\u0438\u043A \u043D\u0430\u043D\u043E\u0441\u0438\u0442
      \u0443\u0440\u043E\u043D \u043D\u0430\u0432\u044B\u043A\u043E\u043C, \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442\u0441\u044F
      1 \u0414\u043E\u0436\u0434\u0435\u0432\u043E\u0439 \u043C\u0435\u0447, \u043D\u0430\u043D\u043E\u0441\u044F
      \u0446\u0435\u043B\u0438 \u0413\u0438\u0434\u0440\u043E \u0443\u0440\u043E\u043D,
      \u0440\u0430\u0432\u043D\u044B\u0439 40% \u0410\u0422\u041A (\u0441\u043A\u043E\u043E\u0440\u0434\u0438\u043D\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0439
      \u0443\u0440\u043E\u043D). \u0421\u0431\u0440\u0430\u0441\u044B\u0432\u0430\u0435\u0442\u0441\u044F
      \u043F\u0440\u0438 \u043F\u0430\u0434\u0435\u043D\u0438\u0438 \u0432\u043B\u0430\u0434\u0435\u043B\u044C\u0446\u0430."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
