  m_SharedData: {fileID: 11400000, guid: eced69ca459a85843bc2821799f89062, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 33076883456
    m_Localized: "\u041D\u0435\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 1001
    m_Localized: "\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u0430\u044F
      \u0432\u0430\u043B\u044E\u0442\u0430 \u0422\u0435\u0439\u0432\u0430\u0442\u0430,
      \u043F\u0440\u0438\u043D\u0438\u043C\u0430\u0435\u043C\u0430\u044F \u043F\u043E\u0432\u0441\u044E\u0434\u0443
      \u043D\u0430 \u043A\u043E\u043D\u0442\u0438\u043D\u0435\u043D\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 1002
    m_Localized: "\u0421\u0435\u043C\u044F \u0441\u0443\u0434\u044C\u0431\u044B,
      \u0441\u0432\u044F\u0437\u044B\u0432\u0430\u044E\u0449\u0435\u0435 \u043C\u0435\u0447\u0442\u044B
      \u0432\u043E\u0435\u0434\u0438\u043D\u043E. \u0415\u0433\u043E \u0441\u0438\u044F\u043D\u0438\u0435
      \u0441\u043F\u043B\u0435\u0442\u0430\u0435\u0442 \u0441\u0443\u0434\u044C\u0431\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 1003
    m_Localized: "\u042D\u043D\u0435\u0440\u0433\u0438\u044F, \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u043C\u0430\u044F
      \u043F\u0443\u0442\u0435\u0448\u0435\u0441\u0442\u0432\u0435\u043D\u043D\u0438\u043A\u0430\u043C\u0438
      \u043F\u0440\u0438 \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0438
      \u043C\u0438\u0440\u0430. \u0412\u043E\u0441\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F
      \u0441\u043E \u0432\u0440\u0435\u043C\u0435\u043D\u0435\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 1004
    m_Localized: "\u041C\u0430\u0433\u0430\u0442\u0430\u043C\u0430, \u0445\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u043D\u0430\u044F
      \u0434\u043B\u044F \u0418\u043D\u0430\u0434\u0437\u0443\u043C\u044B, \u043D\u0430\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u0430\u044F
      \u0441\u0438\u043B\u043E\u0439 \u042D\u043B\u0435\u043A\u0442\u0440\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 1005
    m_Localized: "\u4E16\u754C\u3092\u8D85\u3048\u305F\u539F\u521D\u306E\u6676\u77F3\u3002\u6697\u3044\u5B87\u5B99\u306E\u4E2D\u3067\u3001\u4E3B\u306A\u304D\u5922\u3068\u5E0C\u671B\u304C\u51DD\u7E2E\u3057\u3066\u3067\u304D\u305F\u8F1D\u304D\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 2001
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u0439
      \u0434\u043B\u0438\u043D\u043D\u044B\u0439 \u043C\u0435\u0447, \u0448\u0438\u0440\u043E\u043A\u043E
      \u0440\u0430\u0441\u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0451\u043D\u043D\u044B\u0439
      \u0441\u0440\u0435\u0434\u0438 \u0438\u0441\u043A\u0430\u0442\u0435\u043B\u0435\u0439
      \u043F\u0440\u0438\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2002
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0436\u0435\u043B\u0435\u0437\u043D\u044B\u0439
      \u0449\u0438\u0442, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0439
      \u0431\u043B\u043E\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043E\u0431\u044B\u0447\u043D\u044B\u0435
      \u0430\u0442\u0430\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2003
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u043A\u043E\u0436\u0430\u043D\u044B\u0439
      \u0434\u043E\u0441\u043F\u0435\u0445, \u043B\u0451\u0433\u043A\u0438\u0439
      \u0438 \u043F\u0440\u0430\u043A\u0442\u0438\u0447\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 3001
    m_Localized: "\u7A32\u59BB\u7279\u6709\u306E\u52FE\u7389\u3002\u96F7\u5143\u7D20\u306E\u30A8\u30CD\u30EB\u30AE\u30FC\u3092\u5BBF\u3057\u3066\u3044\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 3002
    m_Localized: "\u041E\u0441\u043E\u0431\u044B\u0439 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
      \u043E\u0442 \u0414\u0438\u043E\u043D\u044B, \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0433\u043E
      \u0431\u0430\u0440\u043C\u0435\u043D\u0430 \u0442\u0430\u0432\u0435\u0440\u043D\u044B
      \xAB\u041A\u043E\u0448\u0430\u0447\u0438\u0439 \u0445\u0432\u043E\u0441\u0442\xBB.
      \u0425\u043E\u0442\u044F \u0441\u0430\u043C\u0430 \u043E\u043D\u0430 \u044D\u0442\u043E\u0433\u043E
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 4001
    m_Localized: "\u041E\u0431\u044B\u0447\u043D\u044B\u0439 \u0438 \u0432\u043A\u0443\u0441\u043D\u044B\u0439
      \u0444\u0440\u0443\u043A\u0442. \u0413\u043E\u0432\u043E\u0440\u044F\u0442,
      \u0447\u0442\u043E \u043E\u0434\u043D\u043E \u044F\u0431\u043B\u043E\u043A\u043E
      \u0432 \u0434\u0435\u043D\u044C \u2014 \u0438 \u0432\u0440\u0430\u0447 \u043D\u0435
      \u043D\u0443\u0436\u0435\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 4002
    m_Localized: "\u65B0."
    m_Metadata:
      m_Items: []
  - m_Id: 4003
    m_Localized: "\u6BBB\u4ED8\u304D\u306E\u9CE5\u306E\u5375\u3002\u8C4A\u5BCC\u306A\u30BF\u30F3\u30D1\u30AF\u8CEA\u3092\u542B\u307F\u3001\u7121\u6570\u306E\u6599\u7406\u306E\u57FA\u672C\u7684\u306A\u98DF\u6750\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 4004
    m_Localized: "\u0417\u043E\u043B\u043E\u0442\u044B\u0435 \u043A\u043E\u043B\u043E\u0441\u044C\u044F,
      \u0434\u0430\u044E\u0449\u0438\u0435 \u0437\u0435\u043C\u043B\u0435 \u043D\u0430\u0434\u0435\u0436\u0434\u0443
      \u0438 \u0441\u0438\u043B\u0443. \u041A\u043B\u044E\u0447\u0435\u0432\u043E\u0439
      \u0438\u043D\u0433\u0440\u0435\u0434\u0438\u0435\u043D\u0442 \u0434\u043B\u044F
      \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u0431\u043B\u044E\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 4005
    m_Localized: "\u98DF\u7269\u7E4A\u7DAD\u304C\u8C4A\u5BCC\u306A\u6839\u83DC\u3002\u683D\u57F9\u3082\u53CE\u7A6B\u3082\u7C21\u5358\u3067\u3001\u591A\u304F\u306E\u6599\u7406\u306E\u30A2\u30AF\u30BB\u30F3\u30C8\u3068\u306A\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 5001
    m_Localized: "\u30E2\u30F3\u30C9\u3092\u4EE3\u8868\u3059\u308B\u7F8E\u9152\u3002\u84B2\u516C\u82F1\u306E\u7A2E\u304B\u3089\u91B8\u9020\u3055\u308C\u3001\u723D\u3084\u304B\u306A\u9999\u308A\u304C\u6F02\u3046\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 5002
    m_Localized: "\u041E\u0441\u043E\u0431\u044B\u0439 \u043D\u0430\u043F\u0438\u0442\u043E\u043A
      \u043E\u0442 \u0414\u0438\u043E\u043D\u044B, \u043F\u043E\u043F\u0443\u043B\u044F\u0440\u043D\u043E\u0433\u043E
      \u0431\u0430\u0440\u043C\u0435\u043D\u0430 \u0442\u0430\u0432\u0435\u0440\u043D\u044B
      \xAB\u041A\u043E\u0448\u0430\u0447\u0438\u0439 \u0445\u0432\u043E\u0441\u0442\xBB.
      \u0425\u043E\u0442\u044F \u0441\u0430\u043C\u0430 \u043E\u043D\u0430 \u044D\u0442\u043E\u0433\u043E
      \u043D\u0438\u043A\u043E\u0433\u0434\u0430 \u043D\u0435 \u043F\u0440\u0438\u0437\u043D\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 5003
    m_Localized: "\u8352\u3005\u3057\u3044\u96F7\u5143\u7D20\u306E\u529B\u3092\u5BBF\u3057\u305F\u6676\u4F53\u3002\u6642\u6298\u5C0F\u3055\u306A\u96FB\u5F27\u3092\u8FF8\u3089\u305B\u3001\u5371\u967A\u306A\u8F1D\u304D\u3092\u653E\u3064\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 5004
    m_Localized: "\u8EFD\u3084\u304B\u306A\u98A8\u5143\u7D20\u306E\u529B\u3092\u5BBF\u3057\u305F\u6676\u4F53\u3002\u8033\u306B\u5F53\u3066\u308B\u3068\u3001\u305D\u3088\u98A8\u306E\u56C1\u304D\u304C\u805E\u3053\u3048\u308B\u3088\u3046\u3060\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 5005
    m_Localized: "\u51DB\u51BD\u305F\u308B\u6C37\u5143\u7D20\u306E\u529B\u3092\u5BBF\u3057\u305F\u6676\u4F53\u3002\u5168\u4F53\u304C\u51B7\u305F\u304F\u3001\u6C7A\u3057\u3066\u6EB6\u3051\u308B\u3053\u3068\u306F\u306A\u3044\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 5006
    m_Localized: "\u843D\u3061\u7740\u3044\u305F\u5CA9\u5143\u7D20\u306E\u529B\u3092\u5BBF\u3057\u305F\u6676\u4F53\u3002\u975E\u5E38\u306B\u786C\u304F\u3001\u6C38\u9060\u3068\u4E0D\u5909\u3092\u8C61\u5FB4\u3057\u3066\u3044\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 5007
    m_Localized: "\u751F\u547D\u529B\u306B\u3042\u3075\u308C\u305F\u8349\u5143\u7D20\u306E\u529B\u3092\u5BBF\u3057\u305F\u6676\u4F53\u3002\u624B\u306E\u4E2D\u3067\u6210\u9577\u3057\u7D9A\u3051\u3066\u3044\u308B\u304B\u306E\u3088\u3046\u306A\u751F\u547D\u306E\u606F\u5439\u3092\u611F\u3058\u3055\u305B\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 6001
    m_Localized: "\u0414\u0440\u0435\u0432\u043D\u0438\u0439 \u043A\u043B\u044E\u0447,
      \u0438\u0437\u043B\u0443\u0447\u0430\u044E\u0449\u0438\u0439 \u0441\u043B\u0430\u0431\u043E\u0435
      \u0441\u0432\u0435\u0447\u0435\u043D\u0438\u0435. \u041A\u0430\u0436\u0435\u0442\u0441\u044F,
      \u043E\u043D \u0441\u043F\u043E\u0441\u043E\u0431\u0435\u043D \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0433\u0434\u0435-\u0442\u043E \u0434\u0430\u0432\u043D\u043E \u0437\u0430\u0431\u044B\u0442\u0443\u044E
      \u0434\u0432\u0435\u0440\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6002
    m_Localized: "\u9EC4\u3070\u3093\u3060\u53E4\u306E\u5DFB\u7269\u3002\u5931\u308F\u308C\u305F\u6587\u660E\u3068\u7981\u5FCC\u306E\u77E5\u8B58\u304C\u8A18\u3055\u308C\u3066\u3044\u308B\u3002"
    m_Metadata:
      m_Items: []
  - m_Id: 1006
    m_Localized: "\u041F\u043E\u0432\u0442\u043E\u0440\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0435\u043D\u043D\u044B\u0435
      \u043A\u0430\u0440\u0442\u044B \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u0436\u0435\u0439
      \u043A\u043E\u043D\u0432\u0435\u0440\u0442\u0438\u0440\u0443\u044E\u0442\u0441\u044F
      \u0432 \u0417\u0432\u0451\u0437\u0434\u043D\u044B\u0439 \u0431\u043B\u0435\u0441\u043A
      \u0434\u043B\u044F \u043E\u0431\u043C\u0435\u043D\u0430 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
