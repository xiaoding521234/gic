    m_Metadata:
      m_Items: []
  - m_Id: 7001
    m_Localized: "\u0427\u0443\u0434\u0435\u0441\u043D\u0430\u044F \u0434\u0435\u0432\u0443\u0448\u043A\u0430-\u0434\u0440\u0430\u043A\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 7002
    m_Localized: "\u0422\u0430\u0439\u043D\u044B\u0439 \u043F\u043E\u0441\u043B\u0430\u043D\u043D\u0438\u043A
