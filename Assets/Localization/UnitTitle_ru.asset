      m_Items: []
  - m_Id: 4005
    m_Localized: "\u0421\u043B\u0438\u0432\u0430 \u0432 \u0441\u043D\u0435\u0433\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 4006
    m_Localized: "\u041C\u044F\u0433\u043A\u0438\u0439 \u0431\u0440\u0438\u0437 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 5001
    m_Localized: "\u041D\u0435\u0436\u043D\u044B\u0439 \u0441\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5002
    m_Localized: "\u041F\u0451\u0441-\u0432\u043E\u0438\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 5003
    m_Localized: "\u041A\u043E\u0448\u043A\u0430 \u043D\u0430 \u043A\u0430\u0440\u043D\u0438\u0437\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6001
    m_Localized: "\u041D\u0430\u0437\u0438\u0434\u0430\u0442\u0435\u043B\u044C\u043D\u043E\u0435
