    m_Metadata:
      m_Items: []
  - m_Id: 3015
    m_Localized: "\u0418\u0437\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u043E \u043D\u0430\u043A\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442
      {InitEnergy} \u044D\u043D\u0435\u0440\u0433\u0438\u0438 \u0438 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
      \u0435\u0449\u0451 {Value} \u043A\u0430\u0436\u0434\u044B\u0435 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B.
      \u041A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u044D\u043D\u0435\u0440\u0433\u0438\u0438
      \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u043D\u0435 \u043C\u0435\u043D\u044C\u0448\u0435
      {Threshold}, \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0432\u044B\u0445\u043E\u0434\u0438\u0442
      1 {SummonUnit} (\u0440\u0430\u0441\u0445\u043E\u0434\u0443\u0435\u0442\u0441\u044F
      {Threshold} \u044D\u043D\u0435\u0440\u0433\u0438\u0438)."
    m_Metadata:
      m_Items: []
  - m_Id: 3016
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0435 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      \u043B\u0435\u0447\u0438\u0442 \u0441\u043E\u044E\u0437\u043D\u044B\u0445 \u0436\u0438\u0432\u044B\u0445
