  - m_Id: 3014
    m_Localized: "\u041A\u0430\u0436\u0434\u044B\u0435 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B
      \u0435\u0433\u043E \u0432\u043B\u0430\u0434\u0435\u043B\u0435\u0446 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
